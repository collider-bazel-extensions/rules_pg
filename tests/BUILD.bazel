    name = "pg18_smoke_test",
    srcs = ["schema_smoke_test.sh"],
    schema = ":test_schema",
    postgres_version = "18",
    size = "medium",
    tags = ["pg"],
)

# ---------------------------------------------------------------------------
# Tests: verify PostgreSQL binary is installed and functional
# ---------------------------------------------------------------------------

pg_test(
    name = "pg_binary_test",
    srcs = ["pg_binary_test.sh"],
    schema = ":test_schema",
    size = "medium",
    tags = ["pg"],
)

# ---------------------------------------------------------------------------
# Seed data: CSV-based loading
# ---------------------------------------------------------------------------

pg_seed_data(
    name = "csv_seed",
    schema = ":test_schema",
    srcs = ["seed/tags.csv"],
)

# ---------------------------------------------------------------------------
# Tests: CSV seed loading
# ---------------------------------------------------------------------------

pg_test(
    name = "csv_seed_test",
    srcs = ["csv_seed_test.sh"],
    schema = ":test_schema",
    seed = ":csv_seed",
    size = "medium",
    tags = ["pg"],
)

# ---------------------------------------------------------------------------
# Tests: custom database name + credentials
# ---------------------------------------------------------------------------

pg_test(
    name = "custom_db_test",
    srcs = ["seed_smoke_test.sh"],
    schema = ":test_schema",
    seed = ":test_seed",
    database = "myapp_test",
    pg_user = "myapp",
    pg_password = "secret",
    size = "medium",
    tags = ["pg"],
)

# ---------------------------------------------------------------------------
# pg_server + pg_health_check fixtures used by the server-mode tests below
# ---------------------------------------------------------------------------

pg_server(
    name = "pg_server_test_svc",
    schema = ":test_schema",
    seed = ":test_seed",
)

pg_health_check(
    name = "pg_server_test_health",
    server = ":pg_server_test_svc",
)

# ---------------------------------------------------------------------------
# Tests: pg_server lifecycle
#   - starts cluster, writes env file, schema + seed applied, SIGTERM clean exit
# ---------------------------------------------------------------------------

sh_test(
    name = "pg_server_test",
    srcs = ["pg_server_test.sh"],
    args = ["$(rootpath :pg_server_test_svc)"],
    data = [":pg_server_test_svc"],
    size = "medium",
    tags = ["pg"],
)

# ---------------------------------------------------------------------------
# Tests: pg_health_check script
#   - exits non-zero without env file, exits 0 with it
#   Does not start a real server; manipulates the env file directly.
# ---------------------------------------------------------------------------

sh_test(
    name = "pg_health_check_test",
    srcs = ["pg_health_check_test.sh"],
    args = ["$(rootpath :pg_server_test_health)"],
    data = [":pg_server_test_health"],
    size = "small",
    tags = ["pg"],
)

# The bundled clients are on the test's PATH, at the test's version
# (rules_pg#7). On a host with its own psql, the old behaviour fails this.
[pg_test(
    name = "bundled_bin_{}_test".format(v),
    srcs = ["bundled_bin_test.sh"],
    args = [v],
    postgres_version = v,
    schema = ":test_schema",
    size = "medium",
    tags = ["pg"],
) for v in ["16", "17", "18"]]

# The runnable client targets run the bundled clients at their version and
# resolve relative paths from BUILD_WORKING_DIRECTORY (rules_pg#9).
[pg_test(
    name = "client_tool_{}_test".format(v),
    srcs = ["client_tool_test.sh"],
    args = [v],
    data = ["//:{}_{}".format(t, v) for t in ["psql", "pg_dump", "pg_restore", "pg_dumpall", "pg_isready"]],
    env = {
        "TOOL_" + t: "$(rootpath //:{}_{})".format(t, v)
        for t in ["psql", "pg_dump", "pg_restore", "pg_dumpall", "pg_isready"]
    },
    postgres_version = v,
    schema = ":test_schema",
    size = "medium",
    tags = ["pg"],
) for v in ["16", "17", "18"]]

# ---------------------------------------------------------------------------
# No schema / an empty schema (v0.7.0): `schema` is optional and
# postgres_schema's `srcs` may be empty.
# ---------------------------------------------------------------------------

postgres_schema(name = "empty_schema")

postgres_schema(
    name = "empty_schema_14",
    binary = "//:pg_14",
)

postgres_schema(
    name = "empty_schema_18",
    binary = "//:pg_18",
)

pg_test(
    name = "no_schema_test",
    srcs = ["empty_schema_test.sh"],
    args = ["no_schema_test"],
    size = "medium",
    tags = ["pg"],
)

pg_test(
    name = "empty_schema_test",
    srcs = ["empty_schema_test.sh"],
    args = ["empty_schema_test"],
    schema = ":empty_schema",
    size = "medium",
    tags = ["pg"],
)

# ---------------------------------------------------------------------------
# postgresql.conf settings (v0.7.0)
# ---------------------------------------------------------------------------

pg_test(
    name = "config_test",
    srcs = ["config_test.sh"],
    config = {
        "work_mem": "7MB",
        "cluster_name": "rules_pg's test",
        "max_connections": "42",
        "synchronous_commit": "on",
    },
    size = "medium",
    tags = ["pg"],
)

analysis_test_suite(name = "analysis_tests")

# ---------------------------------------------------------------------------
# Two pg_servers and a pg_test's own instance in one rules_itest
# service_test (v0.7.0): each has its own $TEST_TMPDIR/<name>.pg.
# ---------------------------------------------------------------------------

[
    pg_server(
        name = n,
        schema = ":test_schema",
        tags = ["manual"],
    )
    for n in ["two_a", "two_b"]
]

[
    pg_health_check(
        name = n + "_health",
        server = ":" + n,
        tags = ["manual"],
    )
    for n in ["two_a", "two_b"]
]

[
    itest_service(
        name = n + "_svc",
        exe = ":" + n,
        health_check = ":" + n + "_health",
        tags = ["manual"],
    )
    for n in ["two_a", "two_b"]
]

pg_test(
    name = "two_servers_check",
    srcs = ["two_servers_test.sh"],
    schema = ":test_schema",
    tags = ["manual"],
)

service_test(
    name = "two_servers_test",
    services = [
        ":two_a_svc",
        ":two_b_svc",
    ],
    test = ":two_servers_check",
    size = "medium",
    tags = ["pg"],
)

# A pg_server with the same name as :two_a, from another package, fails at
# once and names both.
sh_test(
    name = "same_name_clash_test",
    srcs = ["same_name_clash_test.sh"],
    args = [
        "$(rootpath :two_a)",
        "$(rootpath //tests/clash:two_a)",
    ],
    data = [
        ":two_a",
        "//tests/clash:two_a",
    ],
    size = "medium",
    tags = ["pg"],
)

# ---------------------------------------------------------------------------
# Nothing is written outside $TEST_TMPDIR (v0.7.0), on the oldest, default
# and newest majors.
# ---------------------------------------------------------------------------

pg_server(
    name = "isolation_server",
    tags = ["manual"],
)

[
    pg_server(
        name = "isolation_server_" + v,
        schema = ":empty_schema_" + v,
        tags = ["manual"],
    )
    for v in ["14", "18"]
]

[
    sh_test(
        name = "isolation_{}_test".format(v),
        srcs = ["isolation_test.sh"],
        args = [
            "$(rootpath :{})".format(server),
            server,
            v,
        ],
        data = [":" + server],
        size = "medium",
        tags = ["pg"],
    )
    for v, server in [
        ("14", "isolation_server_14"),
        ("16", "isolation_server"),
        ("18", "isolation_server_18"),
    ]
]
