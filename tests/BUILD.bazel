load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_pg//:defs.bzl", "pg_health_check", "pg_seed_data", "pg_server", "pg_test", "postgres_schema")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":analysis_tests.bzl", "analysis_test_suite")

# ---------------------------------------------------------------------------
# Schema
# ---------------------------------------------------------------------------

postgres_schema(
    name = "test_schema",
    srcs = [
        "schema/001_init.sql",
        "schema/002_tags.sql",
    ],
)

# ---------------------------------------------------------------------------
# Seed data
# ---------------------------------------------------------------------------

pg_seed_data(
    name = "test_seed",
    schema = ":test_schema",
    srcs = ["seed/seed.sql"],
)

# ---------------------------------------------------------------------------
# Tests: schema only (no seed)
# ---------------------------------------------------------------------------

pg_test(
    name = "schema_smoke_test",
    srcs = ["schema_smoke_test.sh"],
    schema = ":test_schema",
    size = "medium",
    tags = ["pg"],
)

# ---------------------------------------------------------------------------
# Tests: schema + seed
# ---------------------------------------------------------------------------

pg_test(
    name = "seed_smoke_test",
    srcs = ["seed_smoke_test.sh"],
    schema = ":test_schema",
    seed = ":test_seed",
    size = "medium",
    tags = ["pg"],
)

# args / env reach the wrapped test, with location expansion (#5).
pg_test(
    name = "args_test",
    srcs = ["args_test.sh"],
    schema = ":test_schema",
    args = [
        "one",
        "'two words'",
        "$(rootpath args/fixture.txt)",
        "$(rlocationpath args/fixture.txt)",
    ],
    data = ["args/fixture.txt"],
    env = {
        "PG_ARGS_FILE": "$(rootpath args/fixture.txt)",
        "PG_ARGS_PLAIN": "plain",
    },
    size = "medium",
    tags = ["pg"],
)

# ---------------------------------------------------------------------------
